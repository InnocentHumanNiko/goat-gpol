# osu! OAuth application credentials.
# Create an application at https://osu.ppy.sh/home/account/edit#oauth
# The Callback URL must match OSU_REDIRECT_URI (or http://localhost:3000/api/auth/callback in dev).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Optional: override the OAuth callback URL (defaults to <origin>/api/auth/callback)
# OSU_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: path to the sqlite database file (defaults to ./data/app.db)
# DATABASE_PATH=./data/app.db